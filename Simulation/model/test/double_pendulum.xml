<mujoco model="double_pendulum">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <worldbody>
    <body name="base" pos="0 0 1.5">
      <body name="link1">
        <joint name="joint1" type="hinge" axis="0 1 0" damping="0.01"/>
        <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.025" mass="0.5"/>
        <body name="link2" pos="0.4 0 0">
          <joint name="joint2" type="hinge" axis="0 1 0" damping="0.01"/>
          <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.025" mass="0.5"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
