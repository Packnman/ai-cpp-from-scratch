<mujoco model="simple_leg_contact">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <geom friction="1.0 0.02 0.001" condim="3"/>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="3 3 0.1" rgba="0.7 0.7 0.7 1"/>
    <body name="pelvis" pos="0 0 1.0">
      <freejoint name="pelvis_free"/>
      <geom name="pelvis_geom" type="box" size="0.12 0.08 0.08" mass="2.0"/>
      <body name="leg" pos="0 0 -0.08">
        <joint name="hip" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
        <geom name="leg_geom" type="capsule" fromto="0 0 0 0 0 -0.55"
              size="0.045" mass="1.0"/>
        <body name="foot" pos="0 0 -0.57">
          <geom name="foot_geom" type="box" size="0.12 0.07 0.035"
                pos="0.07 0 0" mass="0.4"/>
          <site name="foot_contact_site" pos="0.07 0 -0.035" size="0.02"/>
        </body>
      </body>
    </body>
  </worldbody>
  <sensor>
    <framequat name="pelvis_orientation" objtype="body" objname="pelvis"/>
    <frameangvel name="pelvis_angular_velocity" objtype="body" objname="pelvis"/>
    <jointpos name="hip_position" joint="hip"/>
    <jointvel name="hip_velocity" joint="hip"/>
    <touch name="foot_contact" site="foot_contact_site"/>
  </sensor>
</mujoco>
