<mujoco model="phase1_supported_humanoid">
  <!-- Phase-1 display model. The weld is an explicit temporary stand, not a
       claim that the placeholder humanoid is dynamically identified. -->
  <compiler angle="radian"
            meshdir="../humanoid/assets/mesh"
            texturedir="../humanoid/assets/texture"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <default>
    <joint limited="true" damping="0.05"/>
    <geom friction="0.9 0.02 0.001" condim="3"/>
  </default>
  <include file="../humanoid/body.xml"/>
  <include file="../humanoid/actuators.xml"/>
  <include file="../humanoid/sensors.xml"/>
  <include file="../humanoid/contact.xml"/>
  <equality>
    <weld name="phase1_pelvis_support" body1="pelvis"/>
  </equality>
</mujoco>
