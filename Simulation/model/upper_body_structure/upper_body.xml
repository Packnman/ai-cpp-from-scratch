<mujoco model="upper_body_structure">
  <!--
    Upper-body mock-up with an actuated right arm.

    Coordinate system: x=front, y=left, z=up.  The axial skeleton and left arm
    remain welded.  The right scapula, shoulder and elbow expose the five
    scalar coordinates consumed by HumanoidDemo's muscle-like drivers.
  -->
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.8 0.8 0.8"/>
    <rgba haze="0.15 0.15 0.18 1"/>
    <global azimuth="135" elevation="-12"/>
  </visual>

  <asset>
    <!-- Flat triangular scapulae, viewed from either the front or back. -->
    <mesh name="left_scapula_mesh"
          vertex="-0.17 0.16 1.49  0.03 0.36 1.43  -0.17 0.18 1.17
                  -0.103 0.233 1.363"
          face="0 1 3  1 2 3  2 0 3"/>
    <mesh name="right_scapula_mesh"
          vertex="-0.20 0.20 0.06  0 0 0  -0.20 0.18 -0.26
                  -0.133 0.127 -0.067"
          face="0 3 1  1 3 2  2 3 0"/>
    <!-- Triangular pyramid pelvis.  Vertices 0, 1 and 2 form an isosceles
         triangular base facing upward toward the rib cage.  The midpoint of
         edge 0-1 meets the spine, and vertex 3 is the downward apex. -->
    <mesh name="pelvis_mesh"
          vertex="-0.20 0.24 0.82  -0.20 -0.24 0.82
                  0.10 0 0.82  -0.05 0 0.50"
          face="0 1 2  0 3 1  1 3 2  2 3 0"/>
    <material name="bone" rgba="0.88 0.84 0.70 1"/>
    <material name="joint_marker" rgba="0.95 0.65 0.18 1"/>
  </asset>

  <default>
    <geom contype="0" conaffinity="0" group="1" material="bone"/>
    <site type="sphere" size="0.008" rgba="0.95 0.65 0.18 1" group="2"/>
  </default>

  <worldbody>
    <light name="key_light" pos="1 -1 3" dir="-0.3 0.3 -1"/>
    <camera name="front" pos="2.8 0 1.20" xyaxes="0 1 0 -0.1 0 1"/>
    <camera name="back" pos="-2.8 0 1.20" xyaxes="0 -1 0 0.1 0 1"/>

    <body name="upper_body">
      <!-- Axial skeleton: one ellipsoid rib cage and a three-part spine. -->
      <body name="rib_cage">
        <geom name="rib_cage_bone" type="ellipsoid" pos="0 0 1.24"
              size="0.18 0.25 0.32" rgba="0.88 0.84 0.70 0.42"/>

        <!-- Pectoralis origins: clavicular, central chest and lower chest. -->
        <site name="left_pectoralis_upper_origin" pos="0.14 0.055 1.50"/>
        <site name="left_pectoralis_middle_origin" pos="0.18 0.055 1.28"/>
        <site name="left_pectoralis_lower_origin" pos="0.15 0.080 1.04"/>
        <site name="right_pectoralis_upper_origin" pos="0.14 -0.055 1.50"/>
        <site name="right_pectoralis_middle_origin" pos="0.18 -0.055 1.28"/>
        <site name="right_pectoralis_lower_origin" pos="0.15 -0.080 1.04"/>

        <!-- Serratus origins at the upper, middle and lower flanks. -->
        <site name="left_serratus_upper_origin" pos="0.04 0.245 1.42"/>
        <site name="left_serratus_middle_origin" pos="0.07 0.250 1.27"/>
        <site name="left_serratus_lower_origin" pos="0.05 0.225 1.10"/>
        <site name="right_serratus_upper_origin" pos="0.04 -0.245 1.42"/>
        <site name="right_serratus_middle_origin" pos="0.07 -0.250 1.27"/>
        <site name="right_serratus_lower_origin" pos="0.05 -0.225 1.10"/>

        <!-- The rib cage connects only to the two clavicles. -->
        <site name="left_sternoclavicular_joint" pos="0.14 0.055 1.50"
              size="0.014"/>
        <site name="right_sternoclavicular_joint" pos="0.14 -0.055 1.50"
              size="0.014"/>
      </body>

      <body name="spine_upper">
        <geom name="spine_upper_bone" type="capsule"
              fromto="-0.20 0 1.62 -0.20 0 1.37" size="0.025"/>
        <site name="left_trapezius_upper_origin" pos="-0.20 0.015 1.57"/>
        <site name="right_trapezius_upper_origin" pos="-0.20 -0.015 1.57"/>
      </body>
      <body name="spine_middle">
        <geom name="spine_middle_bone" type="capsule"
              fromto="-0.20 0 1.37 -0.20 0 1.10" size="0.027"/>
        <site name="left_trapezius_middle_origin" pos="-0.20 0.015 1.36"/>
        <site name="right_trapezius_middle_origin" pos="-0.20 -0.015 1.36"/>
        <site name="left_trapezius_lower_origin" pos="-0.20 0.015 1.20"/>
        <site name="right_trapezius_lower_origin" pos="-0.20 -0.015 1.20"/>
        <site name="left_latissimus_upper_origin" pos="-0.20 0.020 1.27"/>
        <site name="right_latissimus_upper_origin" pos="-0.20 -0.020 1.27"/>
      </body>
      <body name="spine_lower">
        <geom name="spine_lower_bone" type="capsule"
              fromto="-0.20 0 1.10 -0.20 0 0.82" size="0.030"/>
        <site name="left_latissimus_middle_origin" pos="-0.20 0.020 0.94"/>
        <site name="right_latissimus_middle_origin" pos="-0.20 -0.020 0.94"/>
      </body>
      <body name="pelvis">
        <geom name="pelvis_bone" type="mesh" mesh="pelvis_mesh"
              rgba="0.84 0.78 0.63 0.78"/>
        <site name="spine_pelvis_joint" pos="-0.20 0 0.82" size="0.016"/>
        <site name="left_latissimus_lower_origin" pos="-0.12 0.10 0.80"/>
        <site name="right_latissimus_lower_origin" pos="-0.12 -0.10 0.80"/>
      </body>

      <!-- Left shoulder girdle and arm. -->
      <body name="left_clavicle">
        <geom name="left_clavicle_bone" type="capsule"
              fromto="0.14 0.055 1.50 0.03 0.36 1.43" size="0.018"/>
        <site name="left_acromioclavicular_joint" pos="0.03 0.36 1.43"
              size="0.014"/>
        <site name="left_biceps_origin" pos="0.035 0.345 1.43"/>
        <site name="left_deltoid_anterior_origin" pos="0.045 0.395 1.445"/>
      </body>
      <body name="left_scapula">
        <geom name="left_scapula_bone" type="mesh" mesh="left_scapula_mesh"/>
        <site name="left_glenohumeral_joint" pos="0.03 0.36 1.43"
              size="0.016"/>
        <site name="left_serratus_upper_insertion" pos="-0.175 0.18 1.46"/>
        <site name="left_serratus_middle_insertion" pos="-0.178 0.19 1.32"/>
        <site name="left_serratus_lower_insertion" pos="-0.174 0.19 1.18"/>
        <site name="left_trapezius_upper_insertion" pos="-0.176 0.34 1.43"/>
        <site name="left_trapezius_middle_insertion" pos="-0.178 0.27 1.34"/>
        <site name="left_trapezius_lower_insertion" pos="-0.176 0.19 1.25"/>
        <site name="left_deltoid_lateral_origin" pos="-0.005 0.405 1.44"/>
        <site name="left_deltoid_posterior_origin" pos="-0.165 0.18 1.475"/>
      </body>
      <body name="left_humerus">
        <geom name="left_humerus_bone" type="capsule"
              fromto="0.03 0.36 1.43 0 0.37 1.04" size="0.027"/>
        <site name="left_elbow_joint" pos="0 0.37 1.04" size="0.016"/>
        <site name="left_pectoralis_insertion" pos="0.025 0.365 1.34"/>
        <site name="left_latissimus_upper_insertion" pos="-0.030 0.355 1.35"/>
        <site name="left_latissimus_middle_insertion" pos="-0.030 0.365 1.32"/>
        <site name="left_latissimus_lower_insertion" pos="-0.030 0.375 1.29"/>
        <site name="left_triceps_origin" pos="-0.025 0.385 1.22"/>
        <site name="left_deltoid_insertion" pos="0 0.380 1.27"/>
      </body>
      <body name="left_ulna">
        <geom name="left_ulna_bone" type="capsule"
              fromto="0 0.37 1.04 0.015 0.37 0.72" size="0.021"/>
        <site name="left_biceps_insertion" pos="0.025 0.360 0.99"/>
        <site name="left_triceps_insertion" pos="-0.020 0.380 1.02"/>
      </body>

      <!-- Right shoulder girdle and arm.  Positions below the scapula are
           local to the shared clavicle/scapula/humerus shoulder point. -->
      <body name="right_clavicle">
        <geom name="right_clavicle_bone" type="capsule"
              fromto="0.14 -0.055 1.50 0.03 -0.36 1.43" size="0.018"/>
        <site name="right_acromioclavicular_joint" pos="0.03 -0.36 1.43"
              size="0.014"/>
        <site name="right_biceps_origin" pos="0.035 -0.345 1.43"/>
        <site name="right_deltoid_anterior_origin" pos="0.045 -0.395 1.445"/>
        <body name="right_scapula" pos="0.03 -0.36 1.43">
          <joint name="right_scapula_rotation" type="hinge" axis="-1 0 0"
                 range="-0.35 0.20" damping="0.20"/>
          <inertial pos="-0.13 0.12 -0.07" mass="0.20"
                    diaginertia="0.0030 0.0020 0.0015"/>
          <geom name="right_scapula_bone" type="mesh"
                mesh="right_scapula_mesh"/>
          <site name="right_glenohumeral_joint" pos="0 0 0" size="0.016"/>
          <site name="right_serratus_upper_insertion" pos="-0.205 0.18 0.03"/>
          <site name="right_serratus_middle_insertion" pos="-0.208 0.17 -0.11"/>
          <site name="right_serratus_lower_insertion" pos="-0.204 0.17 -0.25"/>
          <site name="right_trapezius_upper_insertion" pos="-0.206 0.02 0"/>
          <site name="right_trapezius_middle_insertion" pos="-0.208 0.09 -0.09"/>
          <site name="right_trapezius_lower_insertion" pos="-0.206 0.17 -0.18"/>
          <site name="right_deltoid_lateral_origin" pos="-0.035 -0.045 0.01"/>
          <site name="right_deltoid_posterior_origin" pos="-0.195 0.18 0.045"/>

          <body name="right_humerus">
            <joint name="right_shoulder_abduction" type="hinge" axis="1 0 0"
                   range="-2.95 0.35" damping="0.25"/>
            <joint name="right_shoulder_flexion" type="hinge" axis="0 1 0"
                   range="-1.80 1.80" damping="0.25"/>
            <joint name="right_shoulder_rotation" type="hinge" axis="0 0 1"
                   range="-1.20 1.20" damping="0.20"/>
            <inertial pos="-0.015 -0.005 -0.195" mass="0.90"
                      diaginertia="0.0120 0.0120 0.0012"/>
            <geom name="right_humerus_bone" type="capsule"
                  fromto="0 0 0 -0.03 -0.01 -0.39" size="0.027"/>
            <site name="right_elbow_joint" pos="-0.03 -0.01 -0.39"
                  size="0.016"/>
            <site name="right_pectoralis_insertion" pos="-0.005 -0.005 -0.09"/>
            <site name="right_latissimus_upper_insertion" pos="-0.060 0.005 -0.08"/>
            <site name="right_latissimus_middle_insertion" pos="-0.060 -0.005 -0.11"/>
            <site name="right_latissimus_lower_insertion" pos="-0.060 -0.015 -0.14"/>
            <site name="right_triceps_origin" pos="-0.055 -0.025 -0.21"/>
            <site name="right_deltoid_insertion" pos="-0.030 -0.020 -0.16"/>

            <body name="right_ulna" pos="-0.03 -0.01 -0.39">
              <joint name="right_elbow" type="hinge" axis="1 0 0"
                     range="-2.40 0" damping="0.18"/>
              <inertial pos="0.008 0 -0.16" mass="0.65"
                        diaginertia="0.0060 0.0060 0.0007"/>
              <geom name="right_ulna_bone" type="capsule"
                    fromto="0 0 0 0.015 0 -0.32" size="0.021"/>
              <site name="right_biceps_insertion" pos="0.025 0.010 -0.05"/>
              <site name="right_triceps_insertion" pos="-0.020 -0.010 -0.02"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!--
    Each spatial tendon is the visible route of a contraction-only muscle.
    HumanoidDemo supplies bounded muscle-like joint effort to the movable
    right-side coordinates; the left-side routes remain structural only.
  -->
  <tendon>
    <!-- Pectoralis major: upper / middle / lower, left and right. -->
    <spatial name="left_pectoralis_upper" width="0.010" rgba="0.85 0.15 0.18 1"><site site="left_pectoralis_upper_origin"/><site site="left_pectoralis_insertion"/></spatial>
    <spatial name="left_pectoralis_middle" width="0.010" rgba="0.85 0.15 0.18 1"><site site="left_pectoralis_middle_origin"/><site site="left_pectoralis_insertion"/></spatial>
    <spatial name="left_pectoralis_lower" width="0.010" rgba="0.85 0.15 0.18 1"><site site="left_pectoralis_lower_origin"/><site site="left_pectoralis_insertion"/></spatial>
    <spatial name="right_pectoralis_upper" width="0.010" rgba="0.85 0.15 0.18 1"><site site="right_pectoralis_upper_origin"/><site site="right_pectoralis_insertion"/></spatial>
    <spatial name="right_pectoralis_middle" width="0.010" rgba="0.85 0.15 0.18 1"><site site="right_pectoralis_middle_origin"/><site site="right_pectoralis_insertion"/></spatial>
    <spatial name="right_pectoralis_lower" width="0.010" rgba="0.85 0.15 0.18 1"><site site="right_pectoralis_lower_origin"/><site site="right_pectoralis_insertion"/></spatial>

    <!-- Deltoid: anterior / lateral / posterior, sharing one humeral insertion. -->
    <spatial name="left_deltoid_anterior" width="0.010" rgba="0.95 0.78 0.12 1"><site site="left_deltoid_anterior_origin"/><site site="left_deltoid_insertion"/></spatial>
    <spatial name="left_deltoid_lateral" width="0.010" rgba="0.95 0.78 0.12 1"><site site="left_deltoid_lateral_origin"/><site site="left_deltoid_insertion"/></spatial>
    <spatial name="left_deltoid_posterior" width="0.010" rgba="0.95 0.78 0.12 1"><site site="left_deltoid_posterior_origin"/><site site="left_deltoid_insertion"/></spatial>
    <spatial name="right_deltoid_anterior" width="0.010" rgba="0.95 0.78 0.12 1"><site site="right_deltoid_anterior_origin"/><site site="right_deltoid_insertion"/></spatial>
    <spatial name="right_deltoid_lateral" width="0.010" rgba="0.95 0.78 0.12 1"><site site="right_deltoid_lateral_origin"/><site site="right_deltoid_insertion"/></spatial>
    <spatial name="right_deltoid_posterior" width="0.010" rgba="0.95 0.78 0.12 1"><site site="right_deltoid_posterior_origin"/><site site="right_deltoid_insertion"/></spatial>

    <!-- Serratus anterior: upper / middle / lower. -->
    <spatial name="left_serratus_upper" width="0.008" rgba="0.96 0.48 0.15 1"><site site="left_serratus_upper_origin"/><site site="left_serratus_upper_insertion"/></spatial>
    <spatial name="left_serratus_middle" width="0.008" rgba="0.96 0.48 0.15 1"><site site="left_serratus_middle_origin"/><site site="left_serratus_middle_insertion"/></spatial>
    <spatial name="left_serratus_lower" width="0.008" rgba="0.96 0.48 0.15 1"><site site="left_serratus_lower_origin"/><site site="left_serratus_lower_insertion"/></spatial>
    <spatial name="right_serratus_upper" width="0.008" rgba="0.96 0.48 0.15 1"><site site="right_serratus_upper_origin"/><site site="right_serratus_upper_insertion"/></spatial>
    <spatial name="right_serratus_middle" width="0.008" rgba="0.96 0.48 0.15 1"><site site="right_serratus_middle_origin"/><site site="right_serratus_middle_insertion"/></spatial>
    <spatial name="right_serratus_lower" width="0.008" rgba="0.96 0.48 0.15 1"><site site="right_serratus_lower_origin"/><site site="right_serratus_lower_insertion"/></spatial>

    <!-- Trapezius: upper / middle / lower. -->
    <spatial name="left_trapezius_upper" width="0.009" rgba="0.66 0.24 0.78 1"><site site="left_trapezius_upper_origin"/><site site="left_trapezius_upper_insertion"/></spatial>
    <spatial name="left_trapezius_middle" width="0.009" rgba="0.66 0.24 0.78 1"><site site="left_trapezius_middle_origin"/><site site="left_trapezius_middle_insertion"/></spatial>
    <spatial name="left_trapezius_lower" width="0.009" rgba="0.66 0.24 0.78 1"><site site="left_trapezius_lower_origin"/><site site="left_trapezius_lower_insertion"/></spatial>
    <spatial name="right_trapezius_upper" width="0.009" rgba="0.66 0.24 0.78 1"><site site="right_trapezius_upper_origin"/><site site="right_trapezius_upper_insertion"/></spatial>
    <spatial name="right_trapezius_middle" width="0.009" rgba="0.66 0.24 0.78 1"><site site="right_trapezius_middle_origin"/><site site="right_trapezius_middle_insertion"/></spatial>
    <spatial name="right_trapezius_lower" width="0.009" rgba="0.66 0.24 0.78 1"><site site="right_trapezius_lower_origin"/><site site="right_trapezius_lower_insertion"/></spatial>

    <!-- Latissimus dorsi: upper / middle / lower. -->
    <spatial name="left_latissimus_upper" width="0.010" rgba="0.12 0.46 0.82 1"><site site="left_latissimus_upper_origin"/><site site="left_latissimus_upper_insertion"/></spatial>
    <spatial name="left_latissimus_middle" width="0.010" rgba="0.12 0.46 0.82 1"><site site="left_latissimus_middle_origin"/><site site="left_latissimus_middle_insertion"/></spatial>
    <spatial name="left_latissimus_lower" width="0.010" rgba="0.12 0.46 0.82 1"><site site="left_latissimus_lower_origin"/><site site="left_latissimus_lower_insertion"/></spatial>
    <spatial name="right_latissimus_upper" width="0.010" rgba="0.12 0.46 0.82 1"><site site="right_latissimus_upper_origin"/><site site="right_latissimus_upper_insertion"/></spatial>
    <spatial name="right_latissimus_middle" width="0.010" rgba="0.12 0.46 0.82 1"><site site="right_latissimus_middle_origin"/><site site="right_latissimus_middle_insertion"/></spatial>
    <spatial name="right_latissimus_lower" width="0.010" rgba="0.12 0.46 0.82 1"><site site="right_latissimus_lower_origin"/><site site="right_latissimus_lower_insertion"/></spatial>

    <!-- Biceps and triceps: one path of each per side. -->
    <spatial name="left_biceps" width="0.011" rgba="0.90 0.22 0.42 1"><site site="left_biceps_origin"/><site site="left_biceps_insertion"/></spatial>
    <spatial name="right_biceps" width="0.011" rgba="0.90 0.22 0.42 1"><site site="right_biceps_origin"/><site site="right_biceps_insertion"/></spatial>
    <spatial name="left_triceps" width="0.011" rgba="0.18 0.70 0.38 1"><site site="left_triceps_origin"/><site site="left_triceps_insertion"/></spatial>
    <spatial name="right_triceps" width="0.011" rgba="0.18 0.70 0.38 1"><site site="right_triceps_origin"/><site site="right_triceps_insertion"/></spatial>
  </tendon>

  <!-- Native contraction-only muscle actuators.  Their controls are tensile
       force commands in newtons and can never become negative.  The limits
       are provisional engineering assumptions derived from the current
       joint-torque baselines and nominal moment arms. -->
  <actuator>
    <motor name="right_pectoralis_upper_actuator" tendon="right_pectoralis_upper"
           ctrllimited="true" ctrlrange="0 150" forcelimited="true" forcerange="0 150"/>
    <motor name="right_pectoralis_middle_actuator" tendon="right_pectoralis_middle"
           ctrllimited="true" ctrlrange="0 150" forcelimited="true" forcerange="0 150"/>
    <motor name="right_pectoralis_lower_actuator" tendon="right_pectoralis_lower"
           ctrllimited="true" ctrlrange="0 150" forcelimited="true" forcerange="0 150"/>

    <motor name="right_deltoid_anterior_actuator" tendon="right_deltoid_anterior"
           ctrllimited="true" ctrlrange="0 200" forcelimited="true" forcerange="0 200"/>
    <motor name="right_deltoid_lateral_actuator" tendon="right_deltoid_lateral"
           ctrllimited="true" ctrlrange="0 200" forcelimited="true" forcerange="0 200"/>
    <motor name="right_deltoid_posterior_actuator" tendon="right_deltoid_posterior"
           ctrllimited="true" ctrlrange="0 200" forcelimited="true" forcerange="0 200"/>

    <motor name="right_serratus_upper_actuator" tendon="right_serratus_upper"
           ctrllimited="true" ctrlrange="0 100" forcelimited="true" forcerange="0 100"/>
    <motor name="right_serratus_middle_actuator" tendon="right_serratus_middle"
           ctrllimited="true" ctrlrange="0 100" forcelimited="true" forcerange="0 100"/>
    <motor name="right_serratus_lower_actuator" tendon="right_serratus_lower"
           ctrllimited="true" ctrlrange="0 100" forcelimited="true" forcerange="0 100"/>

    <motor name="right_trapezius_upper_actuator" tendon="right_trapezius_upper"
           ctrllimited="true" ctrlrange="0 100" forcelimited="true" forcerange="0 100"/>
    <motor name="right_trapezius_middle_actuator" tendon="right_trapezius_middle"
           ctrllimited="true" ctrlrange="0 100" forcelimited="true" forcerange="0 100"/>
    <motor name="right_trapezius_lower_actuator" tendon="right_trapezius_lower"
           ctrllimited="true" ctrlrange="0 100" forcelimited="true" forcerange="0 100"/>

    <motor name="right_latissimus_upper_actuator" tendon="right_latissimus_upper"
           ctrllimited="true" ctrlrange="0 120" forcelimited="true" forcerange="0 120"/>
    <motor name="right_latissimus_middle_actuator" tendon="right_latissimus_middle"
           ctrllimited="true" ctrlrange="0 120" forcelimited="true" forcerange="0 120"/>
    <motor name="right_latissimus_lower_actuator" tendon="right_latissimus_lower"
           ctrllimited="true" ctrlrange="0 120" forcelimited="true" forcerange="0 120"/>

    <motor name="right_biceps_actuator" tendon="right_biceps"
           ctrllimited="true" ctrlrange="0 500" forcelimited="true" forcerange="0 500"/>
    <motor name="right_triceps_actuator" tendon="right_triceps"
           ctrllimited="true" ctrlrange="0 500" forcelimited="true" forcerange="0 500"/>
  </actuator>
</mujoco>
