{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/Simulation/include",
                "${workspaceFolder}/third_party/sqlite",
                "${workspaceFolder}/lib/include",
                "${workspaceFolder}/third_party",
                "${workspaceFolder}/build/agent-debug/_deps/mujoco-src/include",
                "/usr/local/cuda/targets/x86_64-linux/include"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/Simulation/include",
                    "${workspaceFolder}/build/agent-debug/_deps/mujoco-src/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "compileCommands": "${workspaceFolder}/build/agent-debug/compile_commands.json",
            "compilerPath": "/usr/bin/g++",
            "compilerArgs": [
                "-std=c++20"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}
